{
  "name": "@rsbuild/plugin-stylus",
  "version": "2.0.1",
  "description": "Stylus plugin for Rsbuild",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-stylus",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-stylus#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-stylus/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib -w",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "prepare": "simple-git-hooks",
    "test": "rstest",
    "bump": "pnpx bumpp"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:write"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "stylus": "0.64.0",
    "stylus-loader": "8.1.3"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.0.6",
    "@rsbuild/plugin-rem": "^1.0.5",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.6.1",
    "@rstest/core": "^0.11.1",
    "@rstest/playwright": "^0.11.1",
    "@types/node": "^24.12.4",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.3.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
